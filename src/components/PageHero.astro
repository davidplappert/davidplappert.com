---
export interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
}
const { title, subtitle, eyebrow } = Astro.props;
---
<section class="bg-slate-50 border-b border-slate-200">
  <div class="container-wide py-20">
    {eyebrow && (
      <p class="text-sm text-accent font-semibold uppercase tracking-wider mb-3">{eyebrow}</p>
    )}
    <h1 class="text-4xl md:text-5xl font-bold text-navy-900 leading-tight max-w-3xl">{title}</h1>
    {subtitle && (
      <p class="text-xl text-slate-600 mt-6 max-w-2xl leading-relaxed">{subtitle}</p>
    )}
  </div>
</section>
