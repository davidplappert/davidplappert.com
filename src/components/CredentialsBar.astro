---
const credentials = [
  { value: '20', label: 'Years AWS', sublabel: 'since EC2 beta' },
  { value: '2×', label: 'AWS City on a Cloud', sublabel: 'innovation awards' },
  { value: '$500M+', label: 'Annual payments', sublabel: 'processed on AWS' },
  { value: '11,146,689', label: 'US Patent', sublabel: 'cloud architecture' },
];
---
<div class="bg-navy-900 text-white">
  <div class="container-wide py-10 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
    {
      credentials.map((c) => (
        <div>
          <div class="text-2xl md:text-3xl font-bold tabular-nums">{c.value}</div>
          <div class="text-xs text-slate-300 uppercase tracking-wider mt-2 leading-snug">
            {c.label}
            <br />
            <span class="text-slate-400 normal-case tracking-normal">{c.sublabel}</span>
          </div>
        </div>
      ))
    }
  </div>
</div>
