---
const credentials = [
  { value: '19', label: 'Years AWS', sublabel: 'since EC2 beta' },
  { value: '2×', label: 'AWS City on a Cloud' },
  { value: '$3B+', label: 'Processed' },
  { value: '11,146,689', label: 'US Patent', sublabel: 'cloud architecture', url: 'https://patents.google.com/patent/US11146689' },
];
---
<div class="bg-navy-900 text-white border-t-2 border-accent">
  <div class="container-wide py-9 grid grid-cols-2 md:grid-cols-4 gap-y-7 gap-x-6 text-center">
    {
      credentials.map((c) => {
        const inner = (
          <>
            <div class="text-2xl md:text-3xl font-bold tracking-tight tabular-nums">{c.value}</div>
            <div class="mt-2 text-[11px] uppercase tracking-widest text-navy-200 leading-snug">
              {c.label}
              {c.sublabel && (
                <>
                  <br />
                  <span class="text-navy-300 normal-case tracking-normal">{c.sublabel}</span>
                </>
              )}
            </div>
          </>
        );
        return c.url ? (
          <a href={c.url} target="_blank" rel="noopener" class="group block rounded-lg py-2 transition-colors hover:bg-white/5">
            {inner}
          </a>
        ) : (
          <div class="py-2">{inner}</div>
        );
      })
    }
  </div>
</div>
