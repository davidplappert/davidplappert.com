const SCHED_URL = 'https://calendar.app.google/ESxXiEQp9Ky2xTXf6';
---
<footer class="border-t border-slate-200 bg-slate-50">
  <div class="container-wide py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-slate-600">
      David Plappert — Principal Cloud Architect · Consulting Architect · AWS Reliability Lead
    </p>
    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <li><a href={SCHED_URL} target="_blank" rel="noopener" class="text-slate-600 hover:text-navy-900">Schedule a call</a></li>
      <li><a href="mailto:david@davidplappert.com" class="text-slate-600 hover:text-navy-900">Email</a></li>
      <li><a href="https://www.linkedin.com/in/davidplappert" target="_blank" rel="noopener" class="text-slate-600 hover:text-navy-900">LinkedIn</a></li>
      <li><a href="https://github.com/davidplappert" target="_blank" rel="noopener" class="text-slate-600 hover:text-navy-900">GitHub</a></li>
      <li><a href="https://patents.google.com/patent/US11146689" target="_blank" rel="noopener" class="text-slate-600 hover:text-navy-900">US Patent 11,146,689</a></li>
    </ul>
  </div>
  <div class="border-t border-slate-200">
    <div class="container-wide py-5 text-center text-sm text-slate-500">
      &copy; {year} David Plappert. All rights reserved.
