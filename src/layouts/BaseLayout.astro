---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = "Fractional AWS Reliability Lead for revenue-critical systems. US Patent holder, 2x AWS City on a Cloud Award winner, 20 years AWS since EC2 beta.",
  schema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://davidplappert.com/#person",
  "name": "David Plappert",
  "givenName": "David",
  "familyName": "Plappert",
  "jobTitle": "Fractional AWS Reliability Lead",
  "description": "Senior cloud architect specializing in production reliability for revenue-critical AWS systems. 20 years of AWS experience since EC2 beta.",
  "url": "https://davidplappert.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Peoria",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "image": "https://davidplappert.com/images/david-plappert.jpg",
  "sameAs": [
    "https://www.linkedin.com/in/davidplappert",
    "https://patents.google.com/patent/US11146689"
  ],
  "knowsAbout": [
    "Amazon Web Services",
    "AWS Lambda",
    "AWS EKS",
    "Serverless Architecture",
    "Cloud Architecture",
    "Site Reliability Engineering",
    "Production Reliability",
    "Cloud Cost Optimization",
    "Vendor Management",
    "Kubernetes",
    "Terraform",
    "Healthcare Technology",
    "HIPAA Compliance",
    "SOC 2"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "US Patent 11,146,689",
      "description": "Cloud architecture patent, issued October 12, 2021",
      "url": "https://patents.google.com/patent/US11146689"
    }
  ],
  "award": [
    "AWS City on a Cloud Innovation Award 2016",
    "AWS City on a Cloud Innovation Award 2018"
  ],
  "alumniOf": [
    { "@type": "Organization", "name": "IdeaCrew" },
    { "@type": "Organization", "name": "PBS" },
    { "@type": "Organization", "name": "Argonne National Laboratory" },
    { "@type": "Organization", "name": "Best Buy" }
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "TEKsystems"
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://davidplappert.com/#website",
  "url": "https://davidplappert.com",
  "name": "David Plappert",
  "description": "Fractional AWS Reliability Lead for revenue-critical systems.",
  "publisher": { "@id": "https://davidplappert.com/#person" },
  "inLanguage": "en-US"
};

const schemas = [personSchema, websiteSchema];
if (schema) {
  if (Array.isArray(schema)) {
    schemas.push(...schema);
  } else {
    schemas.push(schema);
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="David Plappert" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="David Plappert" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://davidplappert.com/images/david-plappert.jpg" />
    <meta property="og:image:width" content="200" />
    <meta property="og:image:height" content="200" />
    <meta property="og:image:alt" content="David Plappert" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://davidplappert.com/images/david-plappert.jpg" />

    <!-- Article author metadata -->
    <meta name="article:author" content="David Plappert" />

    <!-- LLM hints -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM index" />

    <!-- JSON-LD Structured Data -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
