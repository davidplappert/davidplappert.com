---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  schema?: Record<string, any> | Record<string, any>[];
  header?: boolean;
  footer?: boolean;
}

const {
  title,
  description = "David Plappert — Principal Cloud Architect and AWS consultant. 19 years on AWS, US Patent holder. Available for consulting and contract engagements.",
  schema,
  header = true,
  footer = true,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Build BreadcrumbList from URL path segments
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { position: 1, name: 'Home', item: 'https://davidplappert.com' },
  ...pathSegments.map((segment, idx) => ({
    position: idx + 2,
    name: segment.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    item: `https://davidplappert.com/${pathSegments.slice(0, idx + 1).join('/')}`,
  })),
];

const breadcrumbSchema = pathSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map(b => ({
    "@type": "ListItem",
    "position": b.position,
    "name": b.name,
    "item": b.item,
  })),
} : null;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://davidplappert.com/#person",
  "name": "David Plappert",
  "givenName": "David",
  "familyName": "Plappert",
  "jobTitle": "Principal Cloud Architect, Consulting Architect & AWS Reliability Lead",
  "description": "Principal-level cloud architect, consulting architect, and AWS reliability lead with 19 years of AWS experience since EC2 beta. Patent holder; led the IdeaCrew DevOps team that won the AWS City on a Cloud Award twice (2016, 2018); ships AI-augmented engineering in production. Available for consulting and contract engagements.",
  "url": "https://davidplappert.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Peoria",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "image": "https://davidplappert.com/images/david-plappert.jpg",
  "sameAs": [
    "https://www.linkedin.com/in/davidplappert",
    "https://github.com/davidplappert",
    "https://patents.google.com/patent/US11146689"
  ],
  "knowsAbout": [
    "Amazon Web Services",
    "AWS Lambda",
    "AWS EKS",
    "AWS CDK",
    "Serverless Architecture",
    "Cloud Architecture",
    "Site Reliability Engineering",
    "Production Reliability",
    "AWS Well-Architected Framework",
    "Multi-Account AWS Architecture",
    "Disaster Recovery",
    "High Availability",
    "Platform Engineering",
    "Cloud Consulting",
    "Vendor Architecture Review",
    "Distributed Systems",
    "AI Engineering",
    "Agentic Workflows",
    "Model Context Protocol (MCP)",
    "Cloud Cost Optimization",
    "Kubernetes",
    "Terraform",
    "Healthcare Technology",
    "HIPAA Compliance",
    "SOC 2"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "US Patent 11,146,689",
      "description": "Cloud architecture patent, issued October 12, 2021",
      "url": "https://patents.google.com/patent/US11146689"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "AWS Certified Solutions Architect – Associate",
      "description": "Held 2019–2021"
    }
  ],
  "award": [
    "AWS City on a Cloud Innovation Award 2016 (IdeaCrew DevOps team, led by David Plappert)",
    "AWS City on a Cloud Innovation Award 2018 (IdeaCrew DevOps team, led by David Plappert)"
  ],
  "alumniOf": [
    { "@type": "Organization", "name": "IdeaCrew" },
    { "@type": "Organization", "name": "VentureBeat" },
    { "@type": "Organization", "name": "PBS" },
    { "@type": "Organization", "name": "Argonne National Laboratory" },
    { "@type": "Organization", "name": "Best Buy" }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://davidplappert.com/#website",
  "url": "https://davidplappert.com",
  "name": "David Plappert",
  "description": "Principal Cloud Architect & AWS Reliability Lead — 19 years on AWS since EC2 beta.",
  "publisher": { "@id": "https://davidplappert.com/#person" },
  "inLanguage": "en-US"
};

const schemas = [personSchema, websiteSchema];
if (breadcrumbSchema) schemas.push(breadcrumbSchema);
if (schema) {
  if (Array.isArray(schema)) {
    schemas.push(...schema);
  } else {
    schemas.push(schema);
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BJLLYHHYPR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BJLLYHHYPR');
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wx70vzb6p3");
    </script>

    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="David Plappert" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="David Plappert" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://davidplappert.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Plappert — Principal Cloud Architect & AWS Reliability Lead" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://davidplappert.com/og-image.png" />

    <!-- Article author metadata -->
    <meta name="article:author" content="David Plappert" />

    <!-- LLM hints -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM index" />

    <!-- JSON-LD Structured Data -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    {header && <Header />}
    <main>
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
