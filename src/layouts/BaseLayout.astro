---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = "Fractional AWS Reliability Lead for revenue-critical systems. US Patent holder, 2x AWS City on a Cloud Award winner, 20 years AWS since EC2 beta.",
  schema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Build BreadcrumbList from URL path segments
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { position: 1, name: 'Home', item: 'https://davidplappert.com' },
  ...pathSegments.map((segment, idx) => ({
    position: idx + 2,
    name: segment.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    item: `https://davidplappert.com/${pathSegments.slice(0, idx + 1).join('/')}`,
  })),
];

const breadcrumbSchema = pathSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map(b => ({
    "@type": "ListItem",
    "position": b.position,
    "name": b.name,
    "item": b.item,
  })),
} : null;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://davidplappert.com/#person",
  "name": "David Plappert",
  "givenName": "David",
  "familyName": "Plappert",
  "jobTitle": "Fractional AWS Reliability Lead",
  "description": "Senior cloud architect specializing in production reliability for revenue-critical AWS systems. 20 years of AWS experience since EC2 beta.",
  "url": "https://davidplappert.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Peoria",
    "addressRegion": "IL",
    "addressCountry": "US"
  },
  "image": "https://davidplappert.com/images/david-plappert.jpg",
  "sameAs": [
    "https://www.linkedin.com/in/davidplappert",
    "https://patents.google.com/patent/US11146689"
  ],
  "knowsAbout": [
    "Amazon Web Services",
    "AWS Lambda",
    "AWS EKS",
    "Serverless Architecture",
    "Cloud Architecture",
    "Site Reliability Engineering",
    "Production Reliability",
    "Cloud Cost Optimization",
    "Vendor Management",
    "Kubernetes",
    "Terraform",
    "Healthcare Technology",
    "HIPAA Compliance",
    "SOC 2"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "US Patent 11,146,689",
      "description": "Cloud architecture patent, issued October 12, 2021",
      "url": "https://patents.google.com/patent/US11146689"
    }
  ],
  "award": [
    "AWS City on a Cloud Innovation Award 2016",
    "AWS City on a Cloud Innovation Award 2018"
  ],
  "alumniOf": [
    { "@type": "Organization", "name": "IdeaCrew" },
    { "@type": "Organization", "name": "PBS" },
    { "@type": "Organization", "name": "Argonne National Laboratory" },
    { "@type": "Organization", "name": "Best Buy" }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://davidplappert.com/#website",
  "url": "https://davidplappert.com",
  "name": "David Plappert",
  "description": "Fractional AWS Reliability Lead for revenue-critical systems.",
  "publisher": { "@id": "https://davidplappert.com/#person" },
  "inLanguage": "en-US"
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://davidplappert.com/#service",
  "name": "David Plappert — Fractional AWS Reliability Consulting",
  "url": "https://davidplappert.com",
  "image": "https://davidplappert.com/og-image.svg",
  "provider": { "@id": "https://davidplappert.com/#person" },
  "founder": { "@id": "https://davidplappert.com/#person" },
  "serviceType": "Cloud Architecture & Reliability Consulting",
  "areaServed": {
    "@type": "Place",
    "name": "Worldwide (remote engagements)"
  },
  "knowsAbout": [
    "Vendor-Shipped AWS Gatekeeping",
    "Production Reliability Engineering",
    "AWS Cost Optimization",
    "Cloud Architecture",
    "Vendor Management Technical Authority",
    "Healthcare Exchange Systems",
    "Site Reliability Engineering",
    "AWS Serverless Architecture"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Engagement Types",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fractional AWS Reliability Lead", "description": "Ongoing retainer providing senior IC oversight for production AWS environments." } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AWS Production Audit", "description": "Fixed-scope production reliability and cost assessment with remediation roadmap." } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Vendor Technical Oversight", "description": "Multi-month buyer-side technical gatekeeping for vendor-shipped AWS infrastructure." } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Strategic Cloud Advisory", "description": "Light-retainer senior cloud architecture counsel for engineering leadership." } }
    ]
  },
  "potentialAction": {
    "@type": "ReserveAction",
    "name": "Book a discovery call",
    "target": "https://davidplappert.com/book"
  }
};

const schemas = [personSchema, websiteSchema, professionalServiceSchema];
if (breadcrumbSchema) schemas.push(breadcrumbSchema);
if (schema) {
  if (Array.isArray(schema)) {
    schemas.push(...schema);
  } else {
    schemas.push(schema);
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BJLLYHHYPR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BJLLYHHYPR');
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wx70vzb6p3");
    </script>

    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="David Plappert" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="David Plappert" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://davidplappert.com/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Plappert — Fractional AWS Reliability Lead" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://davidplappert.com/og-image.svg" />

    <!-- Article author metadata -->
    <meta name="article:author" content="David Plappert" />

    <!-- LLM hints -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM index" />

    <!-- JSON-LD Structured Data -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
