---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const credentials = [
  {
    title: 'US Patent 11,146,689',
    detail: 'Cloud architecture, issued October 12, 2021',
    url: 'https://patents.google.com/patent/US11146689',
  },
  {
    title: 'AWS City on a Cloud Award (2016)',
    detail: 'Best Practices Award for DC Health Link, where IdeaCrew led the engineering',
    url: 'https://aws.amazon.com/blogs/publicsector/city-on-a-cloud-innovation-challenge-best-practices-award-winners/',
  },
  {
    title: 'AWS City on a Cloud Award (2018)',
    detail: "IdeaCrew's open-source cloud technology recognized for the second time",
    url: 'https://www.prweb.com/releases/ideacrews_open_source_cloud_based_technology_powers_dc_health_link_to_second_prestigious_amazon_award/prweb15631477.htm',
  },
  { title: 'Principal Cloud Architect & DevOps Lead', detail: '10-year tenure at IdeaCrew' },
  { title: '19 years on AWS', detail: 'Since EC2 beta in 2007' },
  { title: '18F advisor (federal digital services, GSA)', detail: 'AWS architecture consultation on state-government health exchange replication during IdeaCrew tenure' },
  { title: '$500M+ per year', detail: 'In production payments processed on AWS serverless' },
  { title: '$1M/month cloud budget', detail: 'Managed across 12 AWS and 3 Azure accounts' },
];

const roles = [
  {
    title: 'Lead Cloud Engineer / AWS Reliability Lead',
    org: 'Caterpillar Inc. (via TEKsystems)',
    period: 'Sept 2025 – Present · Onsite, Mossville Tech Center, IL',
    body: 'AWS reliability lead for Vertex 3D, Caterpillar\'s real-time 3D collaboration platform powering aftermarket commerce. Sole Caterpillar-side reviewer of monthly vendor-shipped AWS CDK releases — extensive pre-deploy testing and architectural review. Own load testing, monitoring, and alerting strategy across production. Technical lead for Caterpillar\'s Node.js workstream on Vertex 3D and cross-team escalation point across both AWS and Node.js stacks. Built AI-assisted operations workflow using Claude Code that handles deployments, dry-runs, automated bug detection and ticket filing, and end-to-end CI/CD orchestration.',
  },
  {
    title: 'Principal Cloud Architect & DevOps Lead',
    org: 'IdeaCrew',
    period: '2015 – 2025 · Remote',
    body: 'Employee #3; led cloud architecture and DevOps as the company grew past 100 employees. Managed $1M/month cloud spend across 12 AWS and 3 Azure accounts supporting client engagements worth >$50M annually. Owned the AWS architecture that won 2× AWS City on a Cloud awards (2016, 2018) on the DC Health Benefit Exchange platform. Final escalation point for production incidents across every client engagement, backed by extensive New Relic observability. Served as 18F advisor on AWS architecture for state-government health exchange replication. Led multi-year state health insurance migrations from federal FedHub to state-based exchanges including DCHBX, Massachusetts Health Connector for Business, CoverME, and DC Department of Behavioral Health; team held the fastest transition record off FedHub. Led monolith-to-microservices migration onto AWS EKS, ECS, and Lambda.',
  },
  {
    title: 'Senior Cloud Engineer',
    org: 'PBS',
    period: '2014',
    body: 'Built and managed AWS-based RTMP video streaming platform with 99.9% uptime. Implemented adaptive bandwidth modulation, increasing viewer watch time by 158%. Managed two-person development team.',
  },
  {
    title: 'Senior Cloud Architect',
    org: 'Argonne National Laboratory',
    period: '2013',
    body: 'Designed and implemented PHP web application for federal grant applications. Streamlined grant workflows, driving 283% increase in revenue.',
  },
  {
    title: 'Senior Cloud DevOps',
    org: 'Best Buy',
    period: '2012',
    body: 'Led migration from on-premises to AWS across enterprise teams including BestBuy.com, POS, and New Product Ingestion. Reduced infrastructure costs by over 50%. Led 6-member DevOps engineering team.',
  },
];
---
<BaseLayout title="About — David Plappert">
  <PageHero eyebrow="About" title="19 years of production AWS, since EC2 beta." />

  <div class="container-prose py-20">
    <div class="grid md:grid-cols-3 gap-12 mb-16">
      <div class="flex items-start justify-center md:justify-start">
        <div class="relative w-56 h-56">
          <div class="absolute inset-0 bg-accent rounded-full transform translate-x-3 translate-y-3 opacity-90"></div>
          <div class="relative w-full h-full rounded-full overflow-hidden border-4 border-white shadow-xl ring-1 ring-slate-200">
            <img
              src="/images/david-plappert.jpg"
              alt="David Plappert"
              class="w-full h-full object-cover scale-110"
              width="200"
              height="200"
              loading="eager"
            />
          </div>
        </div>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-slate-700">
        <p>
          I'm David Plappert. I've been building on AWS since EC2 was in beta in 2007. That makes me part of the original cloud cohort — a few thousand engineers worldwide who watched AWS grow from a curiosity into the platform that runs half the internet.
        </p>
        <p>
          For the last decade, my focus has been production reliability of revenue-bearing AWS systems. Healthcare exchanges processing $500M+/year. Enterprise vendor-shipped AWS environments. Streaming platforms with 99.9% uptime expectations. The work where downtime has measurable dollar consequences.
        </p>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-navy-900 mt-12 mb-6">Credentials</h2>
    <ul class="space-y-3 text-slate-700">
      {
        credentials.map((c) => (
          <li class="border-l-2 border-accent pl-4">
            {c.url ? (
              <a href={c.url} target="_blank" rel="noopener" class="text-navy-900 font-semibold underline decoration-1 underline-offset-2 hover:decoration-2">
                {c.title}
              </a>
            ) : (
              <strong class="text-navy-900">{c.title}</strong>
            )}
            <span class="text-slate-600"> — {c.detail}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="text-2xl font-bold text-navy-900 mt-16 mb-6">Career</h2>
    <div class="space-y-8">
      {
        roles.map((r) => (
          <div>
            <h3 class="font-semibold text-navy-900 text-lg">{r.title}</h3>
            <p class="text-sm text-slate-500 mb-2">{r.org} · {r.period}</p>
            <p class="text-slate-700 leading-relaxed">{r.body}</p>
          </div>
        ))
      }
    </div>

    <h2 class="text-2xl font-bold text-navy-900 mt-16 mb-4">Why fractional</h2>
    <p class="text-lg text-slate-700 leading-relaxed mb-4">
      I work fractional because the companies whose AWS production is most critical rarely need a full-time senior AWS architect, but they urgently need the role to exist. A ten-to-twenty-hour weekly fractional engagement at the senior level delivers more value than a junior full-time hire — especially for vendor-shipped infrastructure, production reliability, and cost optimization work.
    </p>
    <p class="text-lg text-slate-700 leading-relaxed">
      If that sounds like the gap on your team, let's talk.
    </p>
  </div>

  <section class="bg-navy-900 text-white py-20">
    <div class="container-wide text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Let's work together.</h2>
      <a
        href="/book"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-navy-900 font-semibold rounded-md hover:bg-slate-100 transition-colors"
      >
        Book a call <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
