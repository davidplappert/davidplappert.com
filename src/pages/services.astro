---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const services = [
  {
    num: '01',
    title: 'Fractional AWS Reliability Lead',
    type: 'Ongoing retainer · 10–20 hrs/week',
    summary:
      'A senior AWS practitioner in the seat for ongoing production reliability. The role your team needs but can\'t justify hiring full-time.',
    includes: [
      'Weekly architecture review and operational risk assessment',
      'Vendor-shipped infrastructure release gatekeeping',
      'Production incident escalation and post-mortem ownership',
      'Observability and alerting design',
      'Cross-team senior escalation availability',
    ],
  },
  {
    num: '02',
    title: 'AWS Production Audit',
    type: 'Fixed-scope project · 4–6 weeks',
    summary:
      'A senior-level production reliability assessment of your AWS environment with a remediation roadmap your team can execute against.',
    includes: [
      'End-to-end production risk assessment',
      'Cloud cost analysis (typical finding: 30–40% waste)',
      'Architecture diagram and gap analysis',
      'Prioritized remediation roadmap with effort estimates',
      'Executive summary for leadership and engineering plan for the team',
    ],
  },
  {
    num: '03',
    title: 'Vendor Technical Oversight',
    type: 'Multi-month project · 3–6 months',
    summary:
      'For companies running mission-critical AWS infrastructure built and shipped by a vendor. I sit on your side of the table, technically.',
    includes: [
      'Vendor release gatekeeping (typically monthly cadence)',
      'AWS CDK and IaC review with vendor-skeptic discipline',
      'Pre-production remediation coordination',
      'Vendor performance accountability framework',
      'Production architecture for downstream consumers',
    ],
  },
  {
    num: '04',
    title: 'Strategic Cloud Advisory',
    type: 'Light retainer · ~4 hrs/month',
    summary:
      'Senior cloud architecture counsel on retainer. Monthly check-ins, ad-hoc advisory, decision review for engineering leaders.',
    includes: [
      'Monthly architecture review session',
      'Async availability for ad-hoc technical questions',
      'Decision review on major AWS architecture choices',
      'Quarterly cloud strategy alignment',
    ],
  },
];
---
<BaseLayout title="Services — David Plappert">
  <PageHero
    eyebrow="Services"
    title="Engagements built for senior IC accountability — without the cost of a full-time hire."
    subtitle="Four core ways I work with engineering leaders. Mix and match as needed."
  />

  <section class="container-wide py-20 space-y-16">
    {
      services.map((service, idx) => (
        <div
          class={`grid md:grid-cols-3 gap-12 ${idx < services.length - 1 ? 'pb-16 border-b border-slate-200' : ''}`}
        >
          <div>
            <p class="text-sm text-accent font-semibold uppercase tracking-wider mb-2">{service.num}</p>
            <h2 class="text-2xl font-bold text-navy-900 mb-2">{service.title}</h2>
            <p class="text-sm text-slate-500">{service.type}</p>
          </div>
          <div class="md:col-span-2">
            <p class="text-lg text-slate-700 mb-6 leading-relaxed">{service.summary}</p>
            <h3 class="font-semibold text-navy-900 mb-3">What's included</h3>
            <ul class="space-y-2 text-slate-700">
              {service.includes.map((item) => <li>→ {item}</li>)}
            </ul>
          </div>
        </div>
      ))
    }
  </section>

  <section class="bg-navy-900 text-white py-20">
    <div class="container-wide text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Not sure which fits?</h2>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
        Most engagements start with a discovery call. We figure out the right scope together.
      </p>
      <a
        href="/book"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-navy-900 font-semibold rounded-md hover:bg-slate-100 transition-colors"
      >
        Book a call <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
