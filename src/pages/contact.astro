---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Contact — David Plappert">
  <PageHero
    eyebrow="Contact"
    title="Let's talk."
    subtitle="If your AWS production is too important to leave to chance, that's the conversation we should have."
  />

  <div class="container-prose py-20">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-bold text-navy-900 mb-6">Direct</h2>
        <ul class="space-y-5">
          <li>
            <p class="text-sm text-slate-500 uppercase tracking-wider mb-1">Email</p>
            <a href="mailto:david@davidplappert.com" class="text-lg text-navy-900 hover:underline">
              david@davidplappert.com
            </a>
          </li>
          <li>
            <p class="text-sm text-slate-500 uppercase tracking-wider mb-1">LinkedIn</p>
            <a
              href="https://www.linkedin.com/in/davidplappert"
              target="_blank"
              rel="noopener"
              class="text-lg text-navy-900 hover:underline"
            >
              linkedin.com/in/davidplappert
            </a>
          </li>
          <li>
            <p class="text-sm text-slate-500 uppercase tracking-wider mb-1">Location</p>
            <p class="text-lg text-navy-900">Peoria, IL · Working remote globally</p>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-navy-900 mb-6">What to include in your first message</h2>
        <ul class="space-y-2 text-slate-700">
          <li>→ Your company and approximate size</li>
          <li>→ What AWS systems you're running</li>
          <li>→ What problem you're trying to solve</li>
          <li>→ Whether you're thinking retainer, project, or "let's figure it out"</li>
        </ul>
        <p class="text-sm text-slate-500 mt-6">
          I respond to every legitimate inquiry within 48 hours.
        </p>
      </div>
    </div>

    <div class="mt-16 border-t border-slate-200 pt-12">
      <h2 class="text-2xl font-bold text-navy-900 mb-6">What I do and don't take on</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="font-semibold text-navy-900 mb-3">A good fit</h3>
          <ul class="space-y-2 text-slate-700">
            <li>→ Revenue-bearing AWS production</li>
            <li>→ Vendor-shipped cloud platforms</li>
            <li>→ Healthcare, payments, regulated industries</li>
            <li>→ Fortune 100 or PE-backed mid-market</li>
            <li>→ Engineering teams missing a senior AWS IC</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-navy-900 mb-3">Not a fit</h3>
          <ul class="space-y-2 text-slate-700">
            <li>→ AWS implementation labor (junior tier)</li>
            <li>→ Engagements requiring full-time on-site presence</li>
            <li>→ Pre-revenue startups (your needs differ from mine)</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
