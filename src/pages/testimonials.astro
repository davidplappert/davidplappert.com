---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

// Real testimonials. Attribution is by role + organization context
// (clients agreed to attribution at that level, not by name).
const testimonials = [
  {
    quote: "David is a dev genius.",
    role: "VP of IT",
    context: "Fortune 100 company",
  },
  {
    quote: "David responds quickly and makes sure to explain things as best as possible.",
    role: "CTO",
    context: "Marketing firm with $25M annual revenue",
  },
  {
    quote: "David's a commando. He is fast and efficient at getting results.",
    role: "CTO",
    context: "Non-profit with $10M annual budget",
  },
];

const reviewSchema = testimonials.map(t => ({
  "@context": "https://schema.org",
  "@type": "Review",
  "reviewBody": t.quote,
  "author": {
    "@type": "Person",
    "name": `${t.role}, ${t.context}`,
    "jobTitle": t.role,
  },
  "itemReviewed": {
    "@type": "Person",
    "name": "David Plappert",
    "url": "https://davidplappert.com"
  }
}));
---
<BaseLayout
  title="Testimonials — David Plappert"
  description="What past clients say about working with David Plappert, Fractional AWS Reliability Lead. Fortune 100 VP of IT, mid-market CTO, non-profit technology leader."
  schema={reviewSchema}
>
  <PageHero
    eyebrow="Testimonials"
    title="What people say after working with David."
    subtitle="Anonymized by role and organization at client request. References available on discovery call."
  />

  <div class="container-prose py-20">
    <div class="space-y-12">
      {
        testimonials.map((t) => (
          <figure class="border-l-4 border-accent pl-8 py-2">
            <blockquote class="text-2xl text-slate-700 leading-relaxed italic mb-6">
              "{t.quote}"
            </blockquote>
            <figcaption>
              <div class="font-semibold text-navy-900">{t.role}</div>
              <div class="text-slate-600 text-sm">{t.context}</div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-20 p-8 bg-slate-50 rounded-lg border border-slate-200">
      <h2 class="text-xl font-semibold text-navy-900 mb-3">Want to talk to a reference directly?</h2>
      <p class="text-slate-700 mb-4">
        For engagements at sufficient commitment levels, I will introduce you to a past client who can speak to working with me directly. Book a discovery call and ask.
      </p>
      <a href="/book" class="link-underline font-medium">Book a 15-minute discovery call →</a>
    </div>
  </div>

  <section class="bg-navy-900 text-white py-20">
    <div class="container-wide text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to talk?</h2>
      <a href="/book" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-navy-900 font-semibold rounded-md hover:bg-slate-100 transition-colors">
        Book a call <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
