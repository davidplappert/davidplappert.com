---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

// TODO: Replace these placeholders with real testimonials.
// Recommended sources: former IdeaCrew colleagues, state healthcare exchange leaders
// (DCHBX, Massachusetts Health Connector, CoverME, DC DBH), AWS partners.
// Each testimonial needs: name, title, organization, permission to publish.
const testimonials = [
  {
    quote: "Placeholder. Real testimonial from a former colleague describing David's technical leadership goes here. Aim for 2-3 sentences with a specific result.",
    name: "Name to be added",
    title: "Title",
    org: "Organization",
    relationship: "Worked together at IdeaCrew (2015-2025)",
  },
  {
    quote: "Placeholder. Real testimonial from a healthcare exchange leader about delivery, scale, or production reliability.",
    name: "Name to be added",
    title: "Title",
    org: "State Health Insurance Exchange",
    relationship: "Client engagement via IdeaCrew",
  },
  {
    quote: "Placeholder. Real testimonial from a technical peer or partner about AWS architecture depth.",
    name: "Name to be added",
    title: "Title",
    org: "Organization",
    relationship: "Technical peer / partner",
  },
];

const reviewSchema = testimonials
  .filter(t => !t.quote.startsWith('Placeholder'))
  .map(t => ({
    "@context": "https://schema.org",
    "@type": "Review",
    "reviewBody": t.quote,
    "author": {
      "@type": "Person",
      "name": t.name,
      "jobTitle": t.title,
      "worksFor": { "@type": "Organization", "name": t.org }
    },
    "itemReviewed": {
      "@type": "Person",
      "name": "David Plappert",
      "url": "https://davidplappert.com"
    }
  }));
---
<BaseLayout
  title="Testimonials — David Plappert"
  description="What former colleagues, clients, and partners say about working with David Plappert, Fractional AWS Reliability Lead."
  schema={reviewSchema.length > 0 ? reviewSchema : undefined}
>
  <PageHero
    eyebrow="Testimonials"
    title="What people say about working with David."
    subtitle="From former colleagues at IdeaCrew, state healthcare exchange leaders, and AWS partners."
  />

  <div class="container-prose py-20">
    <div class="space-y-16">
      {
        testimonials.map((t) => (
          <figure class="border-l-4 border-accent pl-8 py-2">
            <blockquote class="text-xl text-slate-700 leading-relaxed italic mb-6">
              "{t.quote}"
            </blockquote>
            <figcaption>
              <div class="font-semibold text-navy-900">{t.name}</div>
              <div class="text-slate-600 text-sm">{t.title}{t.org && ' · '}{t.org}</div>
              {t.relationship && (
                <div class="text-slate-500 text-xs mt-1 uppercase tracking-wider">{t.relationship}</div>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-20 p-8 bg-slate-50 rounded-lg border border-slate-200">
      <h2 class="text-xl font-semibold text-navy-900 mb-3">Want to talk to a reference?</h2>
      <p class="text-slate-700 mb-4">
        For engagements above a certain commitment level, I will introduce you to a past colleague or client who can speak to working with me directly. Book a discovery call and ask.
      </p>
      <a href="/book" class="link-underline font-medium">Book a 15-minute discovery call →</a>
    </div>
  </div>

  <section class="bg-navy-900 text-white py-20">
    <div class="container-wide text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to talk?</h2>
      <a href="/book" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-navy-900 font-semibold rounded-md hover:bg-slate-100 transition-colors">
        Book a call <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
