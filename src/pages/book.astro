---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

// Brand colors passed to Calendly so the widget matches the site exactly.
// Hex values without leading '#' as Calendly expects.
const brand = {
  primary_color: '0a1f3d',      // navy-900 — matches site primary buttons
  text_color: '1f2937',         // slate-800 — matches site body text
  background_color: 'ffffff',   // white
};

// hide_event_type_details:    suppresses the duplicate "15 min · Google Meet" header
//                             since the page hero already states it.
// hide_gdpr_banner:            removes the EU cookie banner when not legally required.
// embed_domain / embed_type:   tells Calendly this is an inline embed on this domain
//                             (improves their analytics + prevents iframe restrictions).
const params = new URLSearchParams({
  ...brand,
  hide_event_type_details: '1',
  hide_gdpr_banner: '1',
  embed_domain: 'davidplappert.com',
  embed_type: 'Inline',
});

const calendlyUrl = `https://calendly.com/phonelivestreaming/aws?${params.toString()}`;
---
<BaseLayout
  title="Book a Call — David Plappert"
  description="Schedule a 15-minute discovery call with David Plappert, Fractional AWS Reliability Lead. Google Meet, no commitment."
>
  <PageHero
    eyebrow="Book a call"
    title="Let's talk about your AWS production."
    subtitle="A focused 15-minute call. No pitch. Just figuring out together if I'm the right fit."
  />

  <!-- Calendly inline widget -->
  <section class="bg-white pt-8 pb-12">
    <div class="container-wide">
      <!-- Loading placeholder appears briefly before Calendly hydrates -->
      <div id="calendly-loading" class="text-center py-12 text-slate-400 text-sm">
        Loading scheduler…
      </div>
      <div
        class="calendly-inline-widget h-[1180px] sm:h-[1000px] md:h-[760px]"
        data-url={calendlyUrl}
        style="min-width:320px;"
      ></div>
      <script
        is:inline
        type="text/javascript"
        src="https://assets.calendly.com/assets/external/widget.js"
        async
        onload="document.getElementById('calendly-loading')?.remove()"
      ></script>
      <noscript>
        <p class="text-center text-slate-600 mt-6">
          JavaScript is required for the booking widget.
          <a href={calendlyUrl} class="link-underline" target="_blank" rel="noopener">
            Open scheduler in a new tab →
          </a>
        </p>
      </noscript>
    </div>
  </section>

  <!-- Calendly chrome tweaks: subtle font-family inheritance and remove the
       default Calendly iframe shadow so it blends with our page. -->
  <style is:global>
    .calendly-inline-widget iframe {
      border: 0 !important;
      box-shadow: none !important;
    }
  </style>

  <!-- What to expect -->
  <section class="bg-slate-50 py-20">
    <div class="container-wide">
      <p class="text-sm text-accent font-semibold uppercase tracking-wider mb-3">What to expect</p>
      <h2 class="text-3xl md:text-4xl font-bold text-navy-900 mb-12 max-w-2xl">
        15 minutes · Google Meet · No commitment.
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <div class="text-3xl font-bold text-navy-900 mb-2">Before</div>
          <h3 class="text-lg font-semibold text-navy-900 mb-3">A few quick questions</h3>
          <p class="text-slate-600 leading-relaxed">
            Calendly will ask you for your company name, what AWS problem you're trying to solve, and optionally your approximate AWS spend. Two minutes, tops.
          </p>
        </div>
        <div>
          <div class="text-3xl font-bold text-navy-900 mb-2">During</div>
          <h3 class="text-lg font-semibold text-navy-900 mb-3">Honest read</h3>
          <p class="text-slate-600 leading-relaxed">
            You walk me through what's going on with your AWS production. I tell you straight whether I think I can help — and what shape that engagement would look like if so.
          </p>
        </div>
        <div>
          <div class="text-3xl font-bold text-navy-900 mb-2">After</div>
          <h3 class="text-lg font-semibold text-navy-900 mb-3">Next steps if it fits</h3>
          <p class="text-slate-600 leading-relaxed">
            If we're a fit, I send a one-page scope and proposal within 48 hours. If we're not, I tell you why and (where I can) point you toward who might be a better match.
          </p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
