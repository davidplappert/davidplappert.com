---
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialsBar from '../components/CredentialsBar.astro';

const SCHED_URL = 'https://calendar.app.google/ESxXiEQp9Ky2xTXf6';
const LINKEDIN_URL = 'https://www.linkedin.com/in/davidplappert';
const GITHUB_URL = 'https://github.com/davidplappert';
---
<BaseLayout
  title="David Plappert — Principal Cloud Architect & Consulting Architect"
  description="David Plappert — Principal Cloud Architect, Consulting Architect & AWS Reliability Lead. 19 years on AWS since EC2 beta, US Patent holder, 2× AWS City on a Cloud Award winner. Available for consulting and contract engagements: AWS architecture review, reliability, and AI-augmented engineering."
  header={false}
  footer={false}
>
  <div class="min-h-screen flex flex-col">
    <!-- Hero -->
    <section class="flex-1 flex items-center justify-center bg-gradient-to-b from-white to-navy-50/60">
      <div class="container-prose flex flex-col items-center text-center py-20">
        <!-- Portrait -->
        <div class="relative w-36 h-36 md:w-44 md:h-44 mb-9">
          <div aria-hidden="true" class="absolute -inset-5 rounded-full bg-accent/15 blur-2xl"></div>
          <div class="relative w-full h-full rounded-full overflow-hidden ring-4 ring-white shadow-xl">
            <img
              src="/images/david-plappert.jpg"
              alt="David Plappert — Principal Cloud Architect"
              class="w-full h-full object-cover scale-110 translate-y-1.5"
              width="176"
              height="176"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>

        <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-navy-900">David Plappert</h1>
        <p class="mt-4 text-lg md:text-xl font-semibold text-accent">Principal Cloud Architect · Consulting Architect</p>
        <p class="mt-2 text-base md:text-lg text-slate-500">Shipped AI for CI/CD &amp; Apps</p>
        <p class="mt-3 text-sm md:text-base text-slate-600">Available for consulting &amp; contract engagements — AWS architecture review, Well-Architected reliability, vendor platform oversight, and AI-augmented engineering</p>

        <div class="mt-8 mb-1 h-px w-16 bg-slate-200"></div>

        <div class="flex flex-col sm:flex-row gap-3 mt-8 w-full sm:w-auto">
          <a href={SCHED_URL} target="_blank" rel="noopener" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            Book a 30-minute call
          </a>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
            Connect on LinkedIn
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.21.7.82.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </section>

    <CredentialsBar />
  </div>
</BaseLayout>
