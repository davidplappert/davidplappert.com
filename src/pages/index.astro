---
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialsBar from '../components/CredentialsBar.astro';
import Footer from '../components/Footer.astro';

const SCHED_URL = 'https://calendar.app.google/ESxXiEQp9Ky2xTXf6';
const LINKEDIN_URL = 'https://www.linkedin.com/in/davidplappert';
const GITHUB_URL = 'https://github.com/davidplappert';

const services = [
  {
    title: 'AWS Architecture Review & Well-Architected Assessment',
    body: 'Independent, senior-level review of your AWS architecture against the Well-Architected Framework — reliability, security, cost, and operational excellence — with a prioritized, actionable findings report.',
  },
  {
    title: 'Vendor Platform Oversight (Buy-Side Review)',
    body: "Paying a vendor seven or eight figures for a platform? I review every vendor-shipped release (CDK, CloudFormation, Terraform) before it reaches your production — the same gatekeeping I perform today for a Fortune 50 manufacturer's revenue-critical platform.",
  },
  {
    title: 'Reliability & Observability Engineering',
    body: 'Load testing strategy, monitoring and alerting design, high-availability and disaster-recovery architecture for revenue-bearing AWS systems — built by someone who has been the final escalation point for a decade.',
  },
  {
    title: 'Cloud Migration Strategy',
    body: 'On-premises to AWS, monolith to microservices, or platform to platform. I led the fastest state-based health exchange transition off the federal FedHub on record, and Best Buy’s billion-dollar e-commerce systems onto AWS.',
  },
  {
    title: 'AI-Augmented Engineering Enablement',
    body: 'I run agentic AI in production today — Claude Code workflows that deploy, dry-run, detect bugs, and file tickets through custom MCP integrations. I can build the same leverage, with governance, into your engineering organization.',
  },
  {
    title: 'Fractional Principal Cloud Architect',
    body: 'Ongoing senior architecture leadership on a retainer basis — roadmap, design reviews, vendor management, and mentoring for teams that need principal-level AWS depth without a full-time hire.',
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://davidplappert.com/#consulting",
  "name": "David Plappert — AWS Cloud Consulting",
  "url": "https://davidplappert.com",
  "provider": { "@id": "https://davidplappert.com/#person" },
  "founder": { "@id": "https://davidplappert.com/#person" },
  "description": "Independent AWS consulting: architecture reviews and Well-Architected assessments, vendor platform oversight, reliability and observability engineering, cloud migration strategy, AI-augmented engineering enablement, and fractional principal cloud architect engagements.",
  "areaServed": { "@type": "Country", "name": "United States" },
  "availableChannel": { "@type": "ServiceChannel", "serviceUrl": "https://calendar.app.google/ESxXiEQp9Ky2xTXf6" },
  "knowsAbout": ["Amazon Web Services", "AWS Well-Architected Framework", "Cloud Architecture", "Site Reliability Engineering", "AI Engineering"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Consulting Services",
    "itemListElement": services.map((s) => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": s.title, "description": s.body }
    }))
  }
};
---
<BaseLayout
  title="David Plappert — Principal Cloud Architect & AWS Consultant"
  description="David Plappert — Principal Cloud Architect, AWS Consultant & Reliability Lead. 19 years on AWS since EC2 beta, US Patent holder, led the team that won 2× AWS City on a Cloud Awards. Available for consulting engagements: AWS architecture review, Well-Architected assessments, vendor platform oversight, reliability engineering, and AI-augmented engineering."
  header={false}
  footer={false}
  schema={serviceSchema}
>
  <div class="flex flex-col">
    <!-- Hero -->
    <section class="bg-gradient-to-b from-white to-navy-50/60">
      <div class="container-prose flex flex-col items-center text-center py-16 md:py-20">
        <!-- Portrait -->
        <div class="relative w-36 h-36 md:w-44 md:h-44 mb-9">
          <div aria-hidden="true" class="absolute -inset-5 rounded-full bg-accent/15 blur-2xl"></div>
          <div class="relative w-full h-full rounded-full overflow-hidden ring-4 ring-white shadow-xl">
            <img
              src="/images/david-plappert.jpg"
              alt="David Plappert — Principal Cloud Architect and AWS consultant"
              class="w-full h-full object-cover scale-110 translate-y-1.5"
              width="176"
              height="176"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>

        <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-navy-900">David Plappert</h1>
        <p class="mt-4 text-lg md:text-xl font-semibold text-accent">Principal Cloud Architect · AWS Consultant</p>
        <p class="mt-2 text-base md:text-lg text-slate-500">Shipped AI for CI/CD &amp; Apps</p>
        <p class="mt-3 text-sm md:text-base text-slate-600 max-w-2xl">Available for consulting &amp; contract engagements — AWS architecture review, Well-Architected reliability, vendor platform oversight, and AI-augmented engineering</p>

        <div class="mt-8 mb-1 h-px w-16 bg-slate-200"></div>

        <div class="flex flex-col sm:flex-row gap-3 mt-8 w-full sm:w-auto">
          <a href={SCHED_URL} target="_blank" rel="noopener" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            Book a 30-minute call
          </a>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
            </svg>
            Connect on LinkedIn
          </a>
          <a href={GITHUB_URL} target="_blank" rel="noopener" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49 1 .11-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .32.21.7.82.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </section>

    <CredentialsBar />

    <!-- Consulting services -->
    <section id="services" class="bg-white">
      <div class="container-wide py-16 md:py-20">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy-900 text-center">Consulting Services</h2>
        <p class="mt-4 text-base md:text-lg text-slate-600 text-center max-w-3xl mx-auto">
          Senior AWS depth, delivered as focused engagements. Every service below is something I do in production today — not a practice area on a slide.
        </p>
        <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.map((s) => (
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-semibold text-navy-900">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.body}</p>
            </div>
          ))}
        </div>
        <div class="mt-12 text-center">
          <a href={SCHED_URL} target="_blank" rel="noopener" class="btn-primary">Book a 30-minute call</a>
        </div>
      </div>
    </section>

    <!-- About / proof -->
    <section id="about" class="bg-navy-50/50 border-t border-slate-200">
      <div class="container-prose py-16 md:py-20">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy-900 text-center">Why teams hire me</h2>
        <div class="mt-8 space-y-5 text-base leading-relaxed text-slate-700">
          <p>
            I have run production workloads on Amazon Web Services for <strong>19 years — since the EC2 beta</strong>. I hold
            <a href="https://patents.google.com/patent/US11146689" target="_blank" rel="noopener" class="link">US Patent 11,146,689</a> for cloud architecture, and the DevOps team I led won the
            <strong>AWS City on a Cloud Award twice</strong> (2016, 2018) for the DC Health Benefit Exchange architecture I owned.
          </p>
          <p>
            Today I am the sole client-side AWS authority for a <strong>Fortune 50 manufacturer's revenue-critical platform</strong> — independently reviewing every vendor-shipped
            AWS CDK release before it reaches production and providing technical oversight of an eight-figure vendor relationship. Before that, I spent a decade as a
            client-facing principal architect at a government health-tech consultancy, where architecture I scoped and delivered <strong>grew engagements by $1M and $2M per year</strong>,
            payment workflows I designed processed <strong>$500M+ annually</strong> under HIPAA, SOC 2, and IRS Publication 1075, and I advised
            <strong>18F (GSA)</strong> on state health-exchange replication.
          </p>
          <p>
            The through-line of my career is <strong>reliability for systems where downtime is measured in dollars per minute</strong> — from Best Buy's e-commerce
            infrastructure on Thanksgiving Day (25% of all US e-commerce traffic, one engineer on site: me) to a real-time 3D commerce platform earning $3,000 a minute.
            And I pair that with modern leverage: I ship <strong>agentic AI engineering in production</strong> — Claude Code workflows that deploy, test, detect bugs, and file
            tickets through custom MCP integrations I wrote.
          </p>
          <p class="text-slate-600">
            Based in Peoria, Illinois · Remote-first, US-wide ·
            <a href={SCHED_URL} target="_blank" rel="noopener" class="link">Schedule a call</a>
          </p>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>
