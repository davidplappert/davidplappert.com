---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const cases = [
  {
    num: 'Case 01',
    title: '$500M/year in healthcare payments on AWS serverless',
    meta: [
      { label: 'Sector', value: 'Government / Healthcare' },
      { label: 'Engagement', value: '10 years, full ownership' },
      { label: 'Scale', value: 'Multi-state exchange' },
    ],
    challenge:
      'State-based healthcare insurance exchanges process hundreds of millions of dollars in payments annually with regulatory enrollment deadlines that cannot move. Transitioning off the federal exchange platform required production-grade AWS infrastructure that did not yet exist at this scale of insurance commerce.',
    approach:
      'Architected and operated AWS serverless infrastructure across multiple state exchanges. Led the migration that holds the record for the fastest state-based exchange transition off FedHub. Built and maintained 300+ automated jobs for HIPAA- and SOC 2-compliant reporting. Led SOC 2 certification and annual audit processes across state clients.',
    results: [
      '$500M+ per year in payments processed on AWS',
      'Fastest state-based exchange off FedHub on record',
      '$1M annual contract expansion from data warehouse build',
      '$2M annual contract expansion from automation framework',
      'Two AWS City on a Cloud awards earned for this work (2016, 2018)',
    ],
  },
  {
    num: 'Case 02',
    title: 'Sole technical owner of a Fortune 100 vendor relationship',
    meta: [
      { label: 'Sector', value: 'Industrial / Heavy equipment' },
      { label: 'Engagement', value: 'Ongoing contractor' },
      { label: 'Scale', value: '$5–10M annual vendor contract' },
    ],
    challenge:
      'A Fortune 100 client buying a high-revenue commerce platform from a third-party vendor needed senior AWS gatekeeping on the buy-side. The vendor shipped monthly AWS infrastructure releases. The client\'s internal AWS team was capacity-constrained and had never covered the platform.',
    approach:
      'Sole senior technical resource on a $5–10M annual vendor relationship. Gatekeeping of every monthly vendor release, typically identifying 2–3 remediation items before production-ready status. Architecture for approximately 30 downstream consumer systems off the platform. Built data ingestion pipeline into Snowflake. Delivered load and functional test suite producing first-time ECS sizing precision — enabling accurate infrastructure budget planning.',
    results: [
      'Eight-figure vendor relationship under senior technical oversight',
      'Zero production incidents attributable to ungated vendor releases',
      'First-time infrastructure cost predictability via load testing precision',
      'Identified by client leadership as Principal Architect successor candidate',
    ],
  },
  {
    num: 'Case 03',
    title: 'Adaptive video streaming on AWS at national broadcaster scale',
    meta: [
      { label: 'Sector', value: 'Media / Broadcasting' },
      { label: 'Engagement', value: 'Senior cloud engineering' },
      { label: 'Scale', value: 'National audience' },
    ],
    challenge:
      'A national public broadcaster needed AWS-based video streaming infrastructure with adaptive bandwidth that worked across viewer connection speeds — without sacrificing the uptime guarantees viewers and partners expected.',
    approach:
      'Built and managed AWS-based RTMP video streaming platform with full reliability and observability ownership. Implemented adaptive bandwidth modulation. Managed development team of two direct reports.',
    results: [
      '99.9% uptime sustained over the engagement',
      '158% increase in viewer watch time after adaptive bandwidth deployment',
      'Platform handled national-scale concurrent viewing',
    ],
  },
];
---
<BaseLayout title="Case Studies — David Plappert">
  <PageHero
    eyebrow="Case studies"
    title="Production work for revenue-critical systems."
    subtitle="Anonymized accounts of past engagements. Each one is real; names are removed for confidentiality."
  />

  <div class="container-wide py-20 space-y-24">
    {
      cases.map((c, idx) => (
        <article class={`grid md:grid-cols-3 gap-12 ${idx > 0 ? 'border-t border-slate-200 pt-24' : ''}`}>
          <div>
            <p class="text-sm text-accent font-semibold uppercase tracking-wider mb-2">{c.num}</p>
            <h2 class="text-3xl font-bold text-navy-900 mb-4 leading-tight">{c.title}</h2>
            <dl class="text-sm text-slate-500 space-y-1">
              {c.meta.map((m) => (
                <div>
                  <dt class="inline font-semibold text-slate-700">{m.label}:</dt>
                  <dd class="inline ml-1">{m.value}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="md:col-span-2 space-y-6">
            <div>
              <h3 class="font-semibold text-navy-900 mb-2">The challenge</h3>
              <p class="text-slate-700 leading-relaxed">{c.challenge}</p>
            </div>
            <div>
              <h3 class="font-semibold text-navy-900 mb-2">The approach</h3>
              <p class="text-slate-700 leading-relaxed">{c.approach}</p>
            </div>
            <div>
              <h3 class="font-semibold text-navy-900 mb-2">The result</h3>
              <ul class="space-y-1 text-slate-700">
                {c.results.map((r) => <li>→ {r}</li>)}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <section class="bg-navy-900 text-white py-20">
    <div class="container-wide text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Have a similar challenge?</h2>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed">
        Let's talk about whether I'm the right fit.
      </p>
      <a
        href="/book"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-navy-900 font-semibold rounded-md hover:bg-slate-100 transition-colors"
      >
        Book a call <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
